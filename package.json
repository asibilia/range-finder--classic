{
  "name": "turbo",
  "description": "Turbo, the Enhancement Shaman HUD for WoW: Forever. Bun monorepo: the addon (@goturbo/addon) and the Turbo site (@goturbo/web).",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@alecsibilia/commit": "^1.0.9",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.27.0",
    "@types/bun": "catalog:",
    "eslint": "^9.27.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "syncpack": "^15.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "^8.59.0"
  },
  "scripts": {
    "changeset": "bunx changeset",
    "changeset:status": "bunx changeset status",
    "check": "bun run check:all && bun run lua:all",
    "check:all": "bun run type-check && bun run lint && bun run syncpack:check",
    "commit": "bunx --bun @alecsibilia/commit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lua:all": "bun run tools:fetch && bun run lua:format:check && bun run lua:check && bun run lua:guard && bun run lua:test",
    "lua:check": "cd packages/addon && bun run lua:check",
    "lua:format": "cd packages/addon && bun run lua:format",
    "lua:format:check": "cd packages/addon && bun run lua:format:check",
    "lua:guard": "cd packages/addon && bun run lua:guard",
    "lua:test": "bun test packages/addon",
    "syncpack:check": "bunx syncpack lint",
    "syncpack:fix": "bunx syncpack fix-mismatches",
    "test": "bun test",
    "tools:fetch": "bun packages/addon/scripts/fetch-tools.ts",
    "type-check": "bun run type-check:addon && bun run type-check:web && bun run type-check:repo",
    "type-check:addon": "cd packages/addon && bunx tsc --noEmit",
    "type-check:repo": "bunx tsc --noEmit",
    "type-check:web": "cd packages/web && bunx tsc --noEmit"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@johnnymorganz/stylua-bin": "^2.5.2",
      "@types/bun": "^1.3.14",
      "lua-wasm-bindings": "^0.5.3",
      "typescript": "^5.9.3"
    }
  }
}
