{
  "name": "turbo",
  "description": "Turbo, the Enhancement Shaman HUD for WoW: Forever. Bun monorepo: the addon (@goturbo/addon) and the Turbo site (@goturbo/web).",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@alecsibilia/commit": "^1.0.9",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.27.0",
    "@types/bun": "catalog:",
    "eslint": "^9.27.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "syncpack": "^15.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "^8.59.0"
  },
  "scripts": {
    "changeset": "bunx changeset",
    "changeset:status": "bunx changeset status",
    "check:all": "bun run type-check && bun run lint && bun run syncpack:check",
    "commit": "bunx --bun @alecsibilia/commit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "syncpack:check": "bunx syncpack lint",
    "syncpack:fix": "bunx syncpack fix-mismatches",
    "type-check": "bun run type-check:web && bun run type-check:repo",
    "type-check:repo": "bunx tsc --noEmit",
    "type-check:web": "cd packages/web && bunx tsc --noEmit"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.14",
      "typescript": "^5.9.3"
    }
  }
}
