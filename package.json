{
  "name": "turbo",
  "description": "Turbo, spell macros for WoW: Forever. Bun monorepo: the addon (@goturbo/addon), the Turbo site (@goturbo/web) and the armory planner (@goturbo/armory).",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@alecsibilia/commit": "^1.0.9",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.27.0",
    "@types/bun": "catalog:",
    "eslint": "^9.27.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "syncpack": "^15.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "^8.59.0"
  },
  "scripts": {
    "armory:schema": "bun packages/armory/scripts/write-results-schema.ts",
    "build:armory": "cd packages/armory && bun run build",
    "changeset": "bunx changeset",
    "changeset:status": "bunx changeset status",
    "changeset:version": "bunx changeset version && bun install",
    "check": "bun run check:all && bun run lua:all",
    "check:all": "bun run type-check && bun run lint && bun run syncpack:check && bun run test:armory",
    "commit": "bunx --bun @alecsibilia/commit",
    "dev:armory": "cd packages/armory && bun run dev",
    "dev:link": "bun packages/addon/scripts/dev-link.ts",
    "dev:watch": "bun packages/addon/scripts/dev-watch.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lua:all": "bun run tools:fetch && bun run lua:format:check && bun run lua:check && bun run lua:guard && bun run lua:test",
    "lua:check": "cd packages/addon && bun run lua:check",
    "lua:format": "cd packages/addon && bun run lua:format",
    "lua:format:check": "cd packages/addon && bun run lua:format:check",
    "lua:guard": "cd packages/addon && bun run lua:guard",
    "lua:test": "bun test --isolate packages/addon",
    "preview:armory": "cd packages/armory && bun run preview",
    "syncpack:check": "bunx syncpack lint",
    "syncpack:fix": "bunx syncpack fix-mismatches",
    "test": "bun test --isolate",
    "test:armory": "bun test --isolate packages/armory",
    "tools:fetch": "bun packages/addon/scripts/fetch-tools.ts",
    "type-check": "bun run type-check:addon && bun run type-check:web && bun run type-check:armory && bun run type-check:repo",
    "type-check:addon": "cd packages/addon && bunx tsc --noEmit",
    "type-check:armory": "cd packages/armory && bun run type-check",
    "type-check:repo": "bunx tsc --noEmit",
    "type-check:web": "cd packages/web && bunx tsc --noEmit"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@cloudflare/vite-plugin": "^1.64.0",
      "@happy-dom/global-registrator": "^20.0.0",
      "@johnnymorganz/stylua-bin": "^2.5.2",
      "@react-router/dev": "^8.5.0",
      "@tailwindcss/vite": "^4.3.3",
      "@testing-library/dom": "^10.4.0",
      "@testing-library/react": "^16.3.0",
      "@testing-library/user-event": "^14.6.1",
      "@types/bun": "^1.3.14",
      "@types/node": "^24.19.2",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "class-variance-authority": "^0.7.1",
      "cn": "^0.5.2",
      "lua-wasm-bindings": "^0.5.3",
      "lucide-react": "^1.70.0",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "react-router": "^8.5.0",
      "recharts": "^3.10.1",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0",
      "typescript": "^5.9.3",
      "vite": "^7.3.7",
      "wrangler": "^4.151.3",
      "zod": "^4.1.0"
    }
  }
}
