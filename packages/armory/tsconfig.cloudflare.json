{
	"extends": "./tsconfig.json",
	// The Worker, against the Workers runtime types Wrangler generates
	// (worker-configuration.d.ts). Kept apart from the page and its tests:
	// the runtime types declare their own `Element` (HTMLRewriter's), which
	// clashes with the DOM's.
	"include": [
		"workers/**/*",
		"worker-configuration.d.ts",
		".react-router/types/+server-build.d.ts"
	],
	"compilerOptions": {
		"composite": true,
		"lib": ["ES2022"],
		"types": ["vite/client"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler"
	}
}
