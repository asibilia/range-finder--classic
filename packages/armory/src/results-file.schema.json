                      }
                    },
                    "required": [
                      "kind",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  "data": {
                    "type": "string",
                    "enum": [
                      "forever",
                      "classic"
                    ],
                    "description": "classic: the item's stats and source may predate Forever."
                  }
                },
                "required": [
                  "item_id",
                  "name",
                  "quality",
                  "item_level",
                  "required_level",
                  "source",
                  "data"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Null: nothing equipped in this slot."
          },
          "imbue": {
            "description": "The temporary weapon imbue on the worn item at export (Windfury Weapon, a poison, a sharpening stone), for the weapon slots. The page names the main hand's in the header: \"Guardian's Dualblade with Windfury Weapon.\" Absent or null: none, or not exported (the header names the weapon alone).",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "alternatives": {
            "type": "array",
            "items": {
