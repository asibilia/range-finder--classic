{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Results file",
  "description": "One file per character per sim run, written by the gear sim and read by the armory planner. Keys are snake_case, and every object is strict.\nThe page also checks these rules, which this JSON Schema can't express, so a file that passes it can still be refused:\n- default_fight_id names a fight in fights.\n- Every fight_id in results, bag_upgrades results, stat_weights and talents.best names a fight in fights.\n- A bag upgrade's results have at most one entry per fight.\n- sheet.weapon_skill.current is at most its max.\n- Every gear in results is worn or a plan_id in plans.\n- Every item_id in a plan's gear is that slot's worn item or one of its alternatives.\n- slots has each slot exactly once.\n- Every fight has a result for worn gear.\n- Each fight_id in fights is unique.\n- Each plan_id is unique.\n- No item_id appears twice in one slot's alternatives.\n- stat_weights has at most one entry per fight.\n- Each Pawn label is unique.\n- No two results share a gear and fight.\n- talents.best.ranks lists every talent in talents.yours exactly once, by talent_id.\n- A talent's rank is at most its max_rank.\n- No two talents in talents.yours share a tier and column.\n- A chain fight has a setup.\n- timeline is null on a chain fight's results (bag upgrade results too).\n- pulls is null on a single fight's results (bag upgrade results too).\nThe runner must also keep these, which nothing checks:\n- Each slot's alternatives come best first: the page shows the first as the slot's best upgrade.\n- talents.yours lists every talent in the tree, at rank 0 or more.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "made_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the runner wrote this file."
    },
    "export_saved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the export this file came from was saved."
    },
    "game_build": {
      "type": "string"
    },
    "sample": {
      "type": "boolean",
      "description": "true: a hand-made file; some numbers in it are made up."
    },
    "provisional": {
      "type": "boolean",
      "description": "true: the sim isn't matched to real fights yet."
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "passed",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "character": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "For display only: never a key, and never in a file name or path."
        },
        "character_key": {
          "description": "A random id the export addon mints once per character (export format 7). It joins this file with the engagement-score file.",
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "race": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "spec": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "level",
        "race",
        "class",
        "spec"
      ],
      "additionalProperties": false
    },
    "sheet_buffed": {
      "type": "boolean",
      "description": "true: the game's sheet as it showed at export, with the buffs that were up."
    },
    "sheet": {
      "type": "object",
      "properties": {
        "strength": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "agility": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "stamina": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "intellect": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "spirit": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "attack_power": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "armor": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "health": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "mana": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "melee_crit_pct": {
          "type": "number"
        },
        "spell_crit_pct": {
          "type": "number"
        },
        "dodge_pct": {
          "type": "number"
        },
        "melee_hit_pct": {
          "type": "number"
        },
        "weapon_skill": {
          "description": "The weapon skill for the main-hand weapon at export, e.g. Axe 148 of 150. The sheet shows it as \"Axe skill 148/150\". Absent or null: not exported (the sheet leaves that line out).",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "weapon_type": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The main-hand weapon's type, as the sheet names its skill: \"Axe\" reads \"Axe skill\"."
                },
                "current": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "weapon_type",
                "current",
                "max"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "strength",
        "agility",
        "stamina",
        "intellect",
        "spirit",
        "attack_power",
        "armor",
        "health",
        "mana",
        "melee_crit_pct",
        "spell_crit_pct",
        "dodge_pct",
        "melee_hit_pct"
      ],
      "additionalProperties": false
    },
    "fights": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fight_id": {
            "type": "string",
            "description": "A sim fight type. A real logged fight is an engagement_id, which only the engagement-score file has."
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "single",
              "chain"
            ]
          },
          "target_level": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "duration_s": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The fight length in seconds. On a chain fight, the length of one pull."
          },
          "melee_miss_pct": {
            "description": "The chance, in percent, that a melee swing misses this fight's target, with the sheet's melee_hit_pct. The page says it under the enemy level: With 0 hit, you miss 8.0% of melee swings at level 33. Absent or null: not simmed (the sentence is left out).",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "setup": {
            "description": "Required on a chain fight; may be absent on a single fight.",
            "type": "object",
            "properties": {
              "starting_mana_pct": {
                "type": "number"
              },
              "being_hit": {
                "type": "boolean"
              },
              "pulls": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "gap_s": {
                "type": "number"
              },
              "drinks": {
                "type": "boolean"
              },
              "target_armor": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "starting_mana_pct",
              "being_hit",
              "pulls",
              "gap_s",
              "drinks",
              "target_armor"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "fight_id",
          "label",
          "kind",
          "target_level",
          "duration_s"
        ],
        "additionalProperties": false
      }
    },
    "default_fight_id": {
      "type": "string",
      "description": "The fight the page opens on: one of fights."
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "head",
              "neck",
              "shoulder",
              "back",
              "chest",
              "wrist",
              "hands",
              "waist",
              "legs",
              "feet",
              "finger_1",
              "finger_2",
              "trinket_1",
              "trinket_2",
              "main_hand",
              "off_hand",
              "relic"
            ]
          },
