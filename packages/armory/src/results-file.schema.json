                        "classic"
                      ],
                      "description": "classic: the item's stats and source may predate Forever."
                    }
                  },
                  "required": [
                    "item_id",
                    "name",
                    "quality",
                    "item_level",
                    "required_level",
                    "source",
                    "data"
                  ],
                  "additionalProperties": false
