{
  "name": "@goturbo/armory",
  "description": "The armory planner: a web page that opens a results file the gear sim made offline and shows a character's gear, the sim's plan and its numbers.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@happy-dom/global-registrator": "catalog:",
    "@react-router/dev": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "scripts": {
    "build": "bunx react-router build",
    "dev": "bunx react-router dev",
    "preview": "bunx react-router build && bunx vite preview",
    "test": "bun test --isolate",
    "type-check": "bunx wrangler types && bunx react-router typegen && bunx tsc -b"
  }
}
