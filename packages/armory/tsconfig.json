{
	// The armory planner, in three projects `bunx tsc -b` checks: the page
	// and its tests (tsconfig.app.json), the Worker (tsconfig.cloudflare.json)
	// and the build-time config (tsconfig.node.json).
	"files": [],
	"references": [
		{ "path": "./tsconfig.app.json" },
		{ "path": "./tsconfig.cloudflare.json" },
		{ "path": "./tsconfig.node.json" }
	],
	"compilerOptions": {
		// Duplicated from tsconfig.app.json: Bun's test runner only
		// reads the nearest tsconfig.json, so the tests' JSX and JSON imports
		// need these here too.
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true
	}
}
