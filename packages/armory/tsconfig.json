{
	// The armory planner: the page (src/), its tests (tests/) and its dev
	// scripts (scripts/).
	"include": ["src/**/*", "tests/**/*", "scripts/**/*"],
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["bun"],
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true
	}
}
