{
	"extends": "./tsconfig.json",
	// The page (src/), its tests (tests/) and dev scripts (scripts/, which
	// import the page's schema), with React Router's generated route types.
	"include": [
		".react-router/types/**/*",
		"src/**/*",
		"tests/**/*",
		"scripts/**/*",
		// @goturbo/sim's TypeScript API, taken as source (no build step).
		"../sim/src",
		// Testchar as a character, and ensureSimBuild with the build's pin
		// it checks, for the browser sim's tests.
		"../sim/tests/helpers",
		"../sim/scripts/pin.ts",
		// Read by tests/repo-setup.test.ts.
		"../../commit.config.ts"
	],
	"exclude": [".react-router/types/+server-build.d.ts"],
	"compilerOptions": {
		"composite": true,
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		// "bun" is for the tests (`bun:test`) and the scripts.
		"types": ["vite/client", "bun"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"esModuleInterop": true,
		"resolveJsonModule": true
	}
}
